{:paths ["src"]
 :deps {io.github.kotoba-lang/org-ietf-jcs
        {:git/url "https://github.com/kotoba-lang/org-ietf-jcs.git"
         :git/sha "ee06e8d51d16265bd366a4fe284ffa1dd617c34e"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        io.github.kotoba-lang/org-w3-did
        {:git/url "https://github.com/kotoba-lang/org-w3-did.git"
         :git/sha "c61e6c95515cd6b66ef19550876d40b7356fc6a7"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  ;; West/sibling workspace development only. Release and CI never use this.
  :dev {:override-deps
        {io.github.kotoba-lang/org-ietf-jcs {:local/root "../org-ietf-jcs"}
         io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org-ietf-ed25519"}
         io.github.kotoba-lang/org-w3-did {:local/root "../org-w3-did"}
         io.github.kotoba-lang/io-multiformats {:local/root "../io-multiformats"}}}}}
